# Used when running the API outside Docker: `set -a; . ./.env; set +a; go run ./cmd/api`
DATABASE_URL=postgres://estates:estates@localhost:5434/estates?sslmode=disable
JWT_SECRET=local-development-secret-change-me-0123456789
ADDR=:4200
LOG_LEVEL=debug
LOG_FORMAT=text
# How long a login lasts and how often rent is generated (defaults shown).
# TOKEN_TTL=168h
# BILLING_INTERVAL=1h
SEED_DEMO=true
