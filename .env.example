# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host ports
DB_PORT=5434
API_PORT=4200
WEB_PORT=5175

# Signs login tokens. Use a long random string outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# debug, info, warn or error
LOG_LEVEL=info

# Create demo@example.com / demo-password with sample data on first start.
SEED_DEMO=true

# Database dumps: where, how often (30m, 6h, 1d...) and how many to keep.
BACKUP_PATH=./backups
BACKUP_INTERVAL=24h
BACKUP_KEEP=14

# Email for password reset. Leave SMTP_HOST empty to turn it off.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Estates <estates@example.com>
# APP_URL=http://localhost:5175

# Set to false once your account exists if strangers can reach the app.
ALLOW_REGISTRATION=true
