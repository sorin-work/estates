# Copy to .env and adjust. docker compose reads .env from the repo root.

# Host ports
DB_PORT=5434
API_PORT=4200
WEB_PORT=5175

# Signs login tokens. Use a long random string outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# debug, info, warn or error
LOG_LEVEL=info

# Create demo@example.com / demo-password with sample data on first start.
SEED_DEMO=true
